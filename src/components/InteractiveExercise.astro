---
const {
  title = 'Ejercicio interactivo',
  description,
  initialCode,
  solutionCode,
} = Astro.props
---

<section class="exercise-lab" data-exercise data-initial-code={initialCode} data-solution-code={solutionCode}>
  <div class="exercise-lab__intro">
    <p class="exercise-lab__eyebrow">Actividad guiada</p>
    <h2>{title}</h2>
    <p>{description}</p>
  </div>

  <div class="exercise-lab__workspace">
    <div class="exercise-lab__editor-panel">
      <div class="exercise-lab__panel-heading">
        <span>Completá el ejemplo</span>
        <span class="exercise-lab__file">app.ts</span>
      </div>
      <textarea class="exercise-editor" spellcheck="false" aria-label={`Código del ejercicio ${title}`}>{initialCode}</textarea>
      <div class="exercise-actions">
        <button class="exercise-button primary" type="button" data-action="run">Comprobar texto</button>
        <button class="exercise-button" type="button" data-action="hint">Ver pista</button>
        <button class="exercise-button" type="button" data-action="reset">Restaurar</button>
        <button class="exercise-button" type="button" data-action="solution">Ver solución</button>
      </div>
      <p class="exercise-feedback" role="status" aria-live="polite" data-feedback>Completá los métodos y comprobá si aparecen los dos patrones esperados.</p>
      <p class="exercise-hint" hidden data-hint>La operación de sumar usa <code>this.counter++</code>; la de restar usa <code>this.counter--</code>.</p>
      <pre class="exercise-solution" hidden data-solution><code>{solutionCode}</code></pre>
    </div>

    <div class="exercise-lab__preview-panel">
      <div class="exercise-lab__panel-heading">
        <span>Vista previa</span>
        <span class="exercise-lab__status" data-preview-status>Bloqueada</span>
      </div>
      <div class="exercise-preview" aria-label="Vista previa del contador">
        <strong>Contador PelelaJS</strong>
        <div class="exercise-preview__row">
          <button class="preview-button" type="button" data-preview="decrement" disabled aria-label="Restar">−</button>
          <output class="preview-value" data-counter>0</output>
          <button class="preview-button" type="button" data-preview="increment" disabled aria-label="Sumar">+</button>
        </div>
      </div>
      <p class="exercise-preview__note">Esta preview no ejecuta el código del editor: es una simulación independiente.</p>
    </div>
  </div>
</section>

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-exercise]')

  roots.forEach((root) => {
    if (root.dataset.ready) return
    root.dataset.ready = 'true'

    const editor = root.querySelector<HTMLTextAreaElement>('.exercise-editor')
    const feedback = root.querySelector<HTMLElement>('[data-feedback]')
    const hint = root.querySelector<HTMLElement>('[data-hint]')
    const solution = root.querySelector<HTMLElement>('[data-solution]')
    const status = root.querySelector<HTMLElement>('[data-preview-status]')
    const counterOutput = root.querySelector<HTMLOutputElement>('[data-counter]')
    const previewButtons = root.querySelectorAll<HTMLButtonElement>('[data-preview]')
    const initialCode = root.dataset.initialCode ?? ''
    const solutionCode = root.dataset.solutionCode ?? ''
    let counter = 0

    const setFeedback = (message: string, kind: 'neutral' | 'success' | 'error' = 'neutral') => {
      if (!feedback) return
      feedback.textContent = message
      feedback.dataset.kind = kind
    }

    const setPreviewEnabled = (enabled: boolean) => {
      previewButtons.forEach((button) => { button.disabled = !enabled })
      if (status) {
        status.textContent = enabled ? 'Lista' : 'Bloqueada'
        status.dataset.ready = enabled ? 'true' : 'false'
      }
    }

    const renderCounter = () => {
      if (counterOutput) counterOutput.value = String(counter)
    }

    root.querySelector<HTMLButtonElement>('[data-action="run"]')?.addEventListener('click', () => {
      const code = editor?.value ?? ''
      const hasIncrement = /increment\s*\(\)[\s\S]*?this\.counter\+\+/.test(code)
      const hasDecrement = /decrement\s*\(\)[\s\S]*?this\.counter--/.test(code)

      if (hasIncrement && hasDecrement) {
        counter = 0
        renderCounter()
        setPreviewEnabled(true)
        setFeedback('Encontramos los dos patrones esperados. Ya podés usar la simulación.', 'success')
      } else {
        setPreviewEnabled(false)
        const missing = !hasIncrement && !hasDecrement ? 'increment y decrement' : !hasIncrement ? 'increment' : 'decrement'
        setFeedback(`Todavía no encontramos el patrón de: ${missing}.`, 'error')
      }
    })

    root.querySelector<HTMLButtonElement>('[data-action="hint"]')?.addEventListener('click', () => {
      if (hint) hint.hidden = !hint.hidden
    })

    root.querySelector<HTMLButtonElement>('[data-action="reset"]')?.addEventListener('click', () => {
      if (editor) editor.value = initialCode
      if (hint) hint.hidden = true
      if (solution) solution.hidden = true
      counter = 0
      renderCounter()
      setPreviewEnabled(false)
      setFeedback('Código restaurado. Completá los métodos y comprobá los patrones.')
    })

    root.querySelector<HTMLButtonElement>('[data-action="solution"]')?.addEventListener('click', () => {
      if (solution) solution.hidden = !solution.hidden
    })

    previewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        if (button.dataset.preview === 'increment') counter++
        if (button.dataset.preview === 'decrement') counter--
        renderCounter()
      })
    })

    setPreviewEnabled(false)
    renderCounter()
    void solutionCode
  })
</script>

<style>
  .exercise-lab {
    /* Evita que el primer bloque de la página quede desfasado por estilos Markdown globales. */
    margin: 2rem 0 !important;
    border: 3px solid var(--pelela-card-border, #20262b);
    border-radius: 14px;
    background: var(--sl-color-bg-sidebar);
    box-shadow: 7px 7px 0 var(--pelela-shadow);
    overflow: hidden;
  }
  .exercise-lab__intro { border-bottom: 2px solid var(--sl-color-hairline); padding: 1.25rem; }
  .exercise-lab__intro h2 { margin: 0 0 0.5rem; }
  .exercise-lab__intro p:last-child { margin-bottom: 0; }
  .exercise-lab__eyebrow { color: var(--sl-color-text-accent); font-size: 0.75rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .exercise-lab__workspace { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(280px, .8fr); }
  .exercise-lab__editor-panel, .exercise-lab__preview-panel { padding: 1rem; }
  .exercise-lab__editor-panel { border-inline-end: 1px solid var(--sl-color-hairline); }
  .exercise-lab__panel-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: .6rem; color: var(--sl-color-white); font-size: .9rem; font-weight: 800; }
  .exercise-lab__file, .exercise-lab__status { border-radius: 999px; background: var(--sl-color-bg-inline-code); color: var(--sl-color-text); font-size: .75rem; padding: .25rem .55rem; }
  .exercise-lab__status[data-ready='true'] { background: #8ed8c1; color: #20262b; }
  .exercise-editor { display: block; width: 100%; min-height: 215px; box-sizing: border-box; resize: vertical; border: 2px solid var(--pelela-code-border); border-radius: 9px; background: var(--pelela-code-bg); color: var(--pelela-code-text); font: .88rem/1.65 var(--sl-font-mono); padding: 1rem; tab-size: 2; }
  .exercise-editor:focus { outline: 3px solid var(--sl-color-accent); outline-offset: 2px; }
  .exercise-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
  .exercise-button { border: 2px solid var(--pelela-card-border); border-radius: 7px; background: var(--sl-color-bg); color: var(--sl-color-white); cursor: pointer; font: inherit; font-size: .8rem; font-weight: 800; padding: .5rem .7rem; }
  .exercise-button:hover { border-color: var(--sl-color-accent); }
  .exercise-button.primary { background: var(--sl-color-accent); color: #20262b; }
  .exercise-feedback { min-height: 1.4rem; margin: .75rem 0 0; font-size: .85rem; font-weight: 700; }
  .exercise-feedback[data-kind='success'] { color: #167354; }
  .exercise-feedback[data-kind='error'] { color: #c2473d; }
  :root[data-theme='dark'] .exercise-feedback[data-kind='success'] { color: #8ed8c1; }
  :root[data-theme='dark'] .exercise-feedback[data-kind='error'] { color: #ff9a8f; }
  .exercise-hint, .exercise-solution { margin: .75rem 0 0; }
  .exercise-hint { border-inline-start: 4px solid #ffdb4d; padding-inline-start: .75rem; font-size: .85rem; }
  .exercise-solution { overflow: auto; border: 2px solid var(--pelela-code-border); border-radius: 8px; background: var(--pelela-code-bg); color: var(--pelela-code-text); padding: .75rem; }
  .exercise-preview { display: grid; min-height: 215px; place-items: center; align-content: center; gap: 1.2rem; border: 3px solid var(--pelela-demo-border); border-radius: 10px; background: var(--pelela-demo-bg); color: var(--pelela-demo-text); box-shadow: 4px 4px 0 var(--pelela-demo-shadow); }
  .exercise-preview__row { display: flex; align-items: center; gap: .8rem; }
  .preview-button { width: 3rem; height: 3rem; border: 2px solid var(--pelela-demo-shadow); border-radius: 5px; background: #5c9dff; box-shadow: 2px 2px 0 var(--pelela-demo-shadow); color: #20262b; cursor: pointer; font-size: 1.2rem; font-weight: 900; }
  .preview-button:disabled { cursor: not-allowed; filter: grayscale(1); opacity: .45; }
  .preview-value { display: grid; width: 3.5rem; height: 3.5rem; place-items: center; border: 2px solid var(--pelela-demo-shadow); border-radius: 5px; background: #ffdb4d; box-shadow: 2px 2px 0 var(--pelela-demo-shadow); color: #20262b; font-size: 1.7rem; font-weight: 950; }
  .exercise-preview__note { margin: .75rem 0 0; font-size: .8rem; }
  @media (max-width: 800px) { .exercise-lab__workspace { grid-template-columns: 1fr; } .exercise-lab__editor-panel { border-inline-end: 0; border-bottom: 1px solid var(--sl-color-hairline); } }
</style>
